      "refersTo": "nav-tab",
      "description": "Phone navigation; becomes the 88px rail on desktop.",
      "html": "<nav class=\"ds-nav\"><button class=\"ds-tab is-active\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><polyline points=\"14.5 17.5 3 6 3 3 6 3 17.5 14.5\"/><line x1=\"13\" x2=\"19\" y1=\"19\" y2=\"13\"/><line x1=\"16\" x2=\"20\" y1=\"16\" y2=\"20\"/><line x1=\"19\" x2=\"21\" y1=\"21\" y2=\"19\"/><polyline points=\"14.5 6.5 18 3 21 3 21 6 17.5 9.5\"/><line x1=\"5\" x2=\"9\" y1=\"14\" y2=\"18\"/><line x1=\"7\" x2=\"4\" y1=\"17\" y2=\"20\"/><line x1=\"3\" x2=\"5\" y1=\"19\" y2=\"21\"/></svg>Combat</button><button class=\"ds-tab\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M6 9H4.5a2.5 2.5 0 0 1 0-5H6\"/><path d=\"M18 9h1.5a2.5 2.5 0 0 0 0-5H18\"/><path d=\"M4 22h16\"/><path d=\"M18 2H6v7a6 6 0 0 0 12 0V2Z\"/></svg>Progrès</button></nav>",
      "css": ".ds-nav{--n0:#0c0c0f;--n1:#131317;--n2:#1c1c22;--n3:#26262e;--n4:#33333d;--n5:#4a4a56;--n6:#74737f;--n7:#a5a4b1;--n9:#ecebf2;--line:#24242b;--ok:#8fd468;--foe:#ee8130;--font-ui:'Figtree',system-ui,sans-serif;--font-fig:'Barlow Semi Condensed','Figtree',system-ui,sans-serif;--ease:cubic-bezier(.16,1,.3,1);}.ds-nav{display:flex;height:64px;padding:6px 4px;background:var(--n0);border-top:1px solid var(--line)}.ds-tab{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;border:0;border-radius:12px;background:transparent;color:var(--n7);font:500 11px/1 var(--font-ui);cursor:pointer}.ds-tab:hover,.ds-tab.is-active{color:var(--n9)}.ds-tab.is-active svg{stroke-width:2.4}.ds-tab:focus-visible{outline:2px solid var(--n9);outline-offset:2px}"
    },
    {
      "name": "Automation Row with Switch",
      "kind": "custom",
      "refersTo": "switch",
      "description": "One automation: name, clamped description, neutral switch.",
      "html": "<div class=\"ds-auto\"><div class=\"ds-auto-main\"><span class=\"ds-auto-name\">Auto hatchery</span><span class=\"ds-auto-sub\">Fills empty slots from the egg list.</span></div><button class=\"ds-sw\" role=\"switch\" aria-checked=\"true\" aria-label=\"Auto hatchery\"><i></i></button></div>",
      "css": ".ds-auto{--n0:#0c0c0f;--n1:#131317;--n2:#1c1c22;--n3:#26262e;--n4:#33333d;--n5:#4a4a56;--n6:#74737f;--n7:#a5a4b1;--n9:#ecebf2;--line:#24242b;--ok:#8fd468;--foe:#ee8130;--font-ui:'Figtree',system-ui,sans-serif;--font-fig:'Barlow Semi Condensed','Figtree',system-ui,sans-serif;--ease:cubic-bezier(.16,1,.3,1);}.ds-auto{display:flex;align-items:center;gap:8px;padding:12px 12px 12px 16px;background:var(--n1);border-bottom:1px solid var(--line)}.ds-auto-main{flex:1;display:flex;flex-direction:column;gap:2px}.ds-auto-name{color:var(--n9);font:600 16px/1.25 var(--font-ui)}.ds-auto-sub{color:var(--n9);font:400 13px/1.35 var(--font-ui)}.ds-sw{position:relative;width:52px;height:32px;border:0;border-radius:16px;background:var(--n4);cursor:pointer;transition:background-color .2s var(--ease)}.ds-sw i{position:absolute;top:4px;left:4px;width:24px;height:24px;border-radius:50%;background:var(--n7);transition:transform .2s var(--ease),background-color .2s var(--ease)}.ds-sw[aria-checked=true]{background:var(--n9)}.ds-sw[aria-checked=true] i{transform:translateX(20px);background:var(--n1)}.ds-sw:focus-visible{outline:2px solid var(--n9);outline-offset:2px}"
    },
    {
      "name": "Combat Card Line",
      "kind": "custom",
      "refersTo": null,
      "description": "Signature: foe name and energy left, HP figures right, energy halo, HP bar in the foe colour.",
      "html": "<div class=\"ds-foe\"><div class=\"ds-foe-head\"><div class=\"ds-foe-id\"><span class=\"ds-foe-name\">Charmander</span><span class=\"ds-type\"><i class=\"ds-dot\"></i>Fire</span></div><div class=\"ds-hp\"><b>214</b><small>/ 320</small></div></div><div class=\"ds-halo\"></div><div class=\"ds-bar\"><i style=\"width:67%\"></i></div></div>",
      "css": ".ds-foe{--n0:#0c0c0f;--n1:#131317;--n2:#1c1c22;--n3:#26262e;--n4:#33333d;--n5:#4a4a56;--n6:#74737f;--n7:#a5a4b1;--n9:#ecebf2;--line:#24242b;--ok:#8fd468;--foe:#ee8130;--font-ui:'Figtree',system-ui,sans-serif;--font-fig:'Barlow Semi Condensed','Figtree',system-ui,sans-serif;--ease:cubic-bezier(.16,1,.3,1);}.ds-foe{position:relative;background:var(--n1);color:var(--n9);padding:16px;min-height:300px;display:flex;flex-direction:column;isolation:isolate}.ds-foe-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px}.ds-foe-id{display:flex;flex-direction:column;gap:8px}.ds-foe-name{font:700 30px/1 var(--font-fig);letter-spacing:.005em}.ds-type{display:inline-flex;align-items:center;gap:6px;color:var(--n7);font:400 13px var(--font-ui)}.ds-dot{width:14px;height:14px;border-radius:50%;background:var(--foe);box-shadow:inset 0 0 0 2px rgba(255,255,255,.28)}.ds-hp{display:flex;align-items:baseline;gap:4px;color:var(--n7);font-variant-numeric:tabular-nums}.ds-hp b{font:600 34px/1 var(--font-fig);color:var(--n9)}.ds-hp small{font:600 15px var(--font-fig)}.ds-halo{flex:1;position:relative;z-index:-1;margin:0 -16px;background:radial-gradient(55% 50% at 50% 50%,color-mix(in oklab,var(--foe) 34%,transparent),transparent 72%)}.ds-bar{height:6px;border-radius:3px;background:var(--n3);overflow:hidden}.ds-bar i{display:block;height:100%;background:var(--foe);border-radius:3px}"
    },
    {
      "name": "Automation Pill",
