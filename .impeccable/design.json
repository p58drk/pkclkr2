  "components": [
    {
      "name": "Tonal Button",
      "kind": "button",
      "refersTo": "button",
      "description": "The single button style; every upstream Bootstrap variant maps to it.",
      "html": "<div class=\"ds-btn-wrap\"><button class=\"ds-btn\">Hatch</button><button class=\"ds-btn ds-btn-bad\">Release</button><button class=\"ds-btn\" disabled>Locked</button></div>",
      "css": ".ds-btn-wrap{--n0:#0c0c0f;--n1:#131317;--n2:#1c1c22;--n3:#26262e;--n4:#33333d;--n5:#4a4a56;--n6:#74737f;--n7:#a5a4b1;--n9:#ecebf2;--line:#24242b;--ok:#8fd468;--foe:#ee8130;--font-ui:'Figtree',system-ui,sans-serif;--font-fig:'Barlow Semi Condensed','Figtree',system-ui,sans-serif;--ease:cubic-bezier(.16,1,.3,1);}.ds-btn-wrap{display:flex;gap:8px;padding:16px;background:var(--n1)}.ds-btn{border:0;border-radius:8px;background:var(--n2);color:var(--n9);font:500 15px/1.4 var(--font-ui);padding:8px 14px;min-height:44px;cursor:pointer;transition:background-color .15s var(--ease),color .15s var(--ease)}.ds-btn:hover{background:var(--n3)}.ds-btn:active{background:var(--n4)}.ds-btn:focus-visible{outline:2px solid var(--n9);outline-offset:2px}.ds-btn-bad{color:#f07167}.ds-btn:disabled{background:var(--n2);color:var(--n6);cursor:default}"
    },
    {
      "name": "Icon Button",
      "kind": "button",
      "refersTo": "icon-button",
      "description": "44px transparent icon control in the top bar and section headers.",
      "html": "<div class=\"ds-ib-wrap\"><button class=\"ds-ib\" aria-label=\"Combat\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><polyline points=\"14.5 17.5 3 6 3 3 6 3 17.5 14.5\"/><line x1=\"13\" x2=\"19\" y1=\"19\" y2=\"13\"/><line x1=\"16\" x2=\"20\" y1=\"16\" y2=\"20\"/><line x1=\"19\" x2=\"21\" y1=\"21\" y2=\"19\"/><polyline points=\"14.5 6.5 18 3 21 3 21 6 17.5 9.5\"/><line x1=\"5\" x2=\"9\" y1=\"14\" y2=\"18\"/><line x1=\"7\" x2=\"4\" y1=\"17\" y2=\"20\"/><line x1=\"3\" x2=\"5\" y1=\"19\" y2=\"21\"/></svg></button></div>",
      "css": ".ds-ib-wrap{--n0:#0c0c0f;--n1:#131317;--n2:#1c1c22;--n3:#26262e;--n4:#33333d;--n5:#4a4a56;--n6:#74737f;--n7:#a5a4b1;--n9:#ecebf2;--line:#24242b;--ok:#8fd468;--foe:#ee8130;--font-ui:'Figtree',system-ui,sans-serif;--font-fig:'Barlow Semi Condensed','Figtree',system-ui,sans-serif;--ease:cubic-bezier(.16,1,.3,1);}.ds-ib-wrap{padding:16px;background:var(--n1)}.ds-ib{width:44px;height:44px;display:grid;place-items:center;border:0;border-radius:12px;background:transparent;color:var(--n7);cursor:pointer}.ds-ib:hover{color:var(--n9);background:var(--n2)}.ds-ib:focus-visible{outline:2px solid var(--n9);outline-offset:2px}"
    },
    {
