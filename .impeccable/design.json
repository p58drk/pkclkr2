      "css": ".ds-in-wrap{--n0:#0c0c0f;--n1:#131317;--n2:#1c1c22;--n3:#26262e;--n4:#33333d;--n5:#4a4a56;--n6:#74737f;--n7:#a5a4b1;--n9:#ecebf2;--line:#24242b;--ok:#8fd468;--foe:#ee8130;--font-ui:'Figtree',system-ui,sans-serif;--font-fig:'Barlow Semi Condensed','Figtree',system-ui,sans-serif;--ease:cubic-bezier(.16,1,.3,1);}.ds-in-wrap{padding:16px;background:var(--n1)}.ds-in{width:100%;min-height:40px;padding:0 12px;background:var(--n2);border:1px solid var(--n3);border-radius:8px;color:var(--n9);font:400 15px var(--font-ui)}.ds-in::placeholder{color:var(--n7)}.ds-in:focus{outline:none;border-color:var(--n6)}"
