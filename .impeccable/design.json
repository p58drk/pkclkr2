      "css": ".ds-chip-wrap{--n0:#0c0c0f;--n1:#131317;--n2:#1c1c22;--n3:#26262e;--n4:#33333d;--n5:#4a4a56;--n6:#74737f;--n7:#a5a4b1;--n9:#ecebf2;--line:#24242b;--ok:#8fd468;--foe:#ee8130;--font-ui:'Figtree',system-ui,sans-serif;--font-fig:'Barlow Semi Condensed','Figtree',system-ui,sans-serif;--ease:cubic-bezier(.16,1,.3,1);}.ds-chip-wrap{padding:16px;background:var(--n1)}.ds-chip{display:inline-flex;align-items:center;gap:6px;min-height:40px;padding:0 12px 0 14px;border:0;border-radius:20px;background:var(--n2);color:var(--n9);font:500 14px var(--font-ui);cursor:pointer}.ds-chip svg{width:16px;height:16px;color:var(--n7)}.ds-chip:hover{background:var(--n3)}.ds-chip:focus-visible{outline:2px solid var(--n9);outline-offset:2px}"
